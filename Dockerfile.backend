FROM oven/bun:1 AS base
WORKDIR /app

# Install curl for Coolify/Docker HTTP healthchecks (GET http://localhost:3000/health)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
# COPY ONLY package.json and lockfiles to cache dependencies
COPY package.json bun.lock biome.json ./
COPY packages/schema/package.json ./packages/schema/package.json
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json
COPY web/package.json ./web/package.json
# Install dependencies (cached)
RUN bun install --frozen-lockfile

# Copy source code (this layer changes frequently)
COPY packages ./packages
COPY backend ./backend

# Cambiar la propiedad de los archivos al usuario sin privilegios
# RUN chown -R bun:bun /app

# Set working directory
WORKDIR /app/backend

# Expose port
EXPOSE 3000

# Start server after running idempotent migrations and global catalog seed
CMD ["sh", "-c", "bun run src/migrate.ts && bun run src/seeds/seed.ts && bun run src/server.ts"]