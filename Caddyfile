{
    # Admin API desactivada para producción
    admin off

    # Traefik / Cloudflare gestionan los certificados SSL
    auto_https off
}

:80 {
    root * /usr/share/caddy

    # Compresión Zstandard y Gzip
    encode zstd gzip

    # 1. Petición interna del Backend para obtener el index.html crudo
    @raw_request {
        header X-Raw-Request "true"
    }
    handle @raw_request {
        rewrite * /index.html
        file_server
    }

    # 2. Service Worker y Manifest (NUNCA cachear como inmutable)
    @pwa_lifecycle path /sw.js /manifest.webmanifest /branding-fallback.js
    handle @pwa_lifecycle {
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # 3. Archivos estáticos inmutables (Vite hash, iconos, assets)
    @static_paths path /assets/* /icons/* /favicon.ico *.js *.css *.jpg *.jpeg *.png *.gif *.ico *.svg *.woff *.woff2 *.webp *.avif
    handle @static_paths {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }

    # 4. Cualquier otro archivo estático físico existente
    @static_assets {
        file
    }
    handle @static_assets {
        file_server {
            precompressed br gzip
        }
    }

    # 5. Redirigir navegación SPA al Backend para branding dinámico
    handle {
        reverse_proxy {$BACKEND_URL:https://api.zelys.app} {
            header_up Host {$BACKEND_HOST:api.zelys.app}
            header_up X-Original-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # 6. Fallback de emergencia: servir index.html local si el backend no responde
    handle_errors {
        rewrite * /index.html
        file_server
    }

    # Cabeceras de Seguridad y CSP
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Permissions-Policy "microphone=(), usb=(), camera=(self), geolocation=(self), payment=(self), display-capture=(self)"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self'; img-src 'self' data: blob: https://flagcdn.com https://*.zelys.app https://zelys.app https:; connect-src 'self' https://zelys.app https://*.zelys.app https://*.r2.cloudflarestorage.com https://challenges.cloudflare.com https://secure.geonames.org https://flagcdn.com http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; frame-src https://challenges.cloudflare.com; manifest-src 'self' https://zelys.app https://*.zelys.app https://api.zelys.app;"
    }
}