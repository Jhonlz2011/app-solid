{
    # Admin API desactivada para producción
    admin off

    # Traefik / Cloudflare gestionan los certificados SSL
    auto_https off
}

:80 {
    root * /usr/share/caddy

    # Compresión Zstandard y Gzip
    encode zstd gzip

    # 1. Petición interna del Backend para obtener el index.html crudo
    @raw_request {
        header X-Raw-Request "true"
    }
    handle @raw_request {
        rewrite * /index.html
        file_server
    }

    # 2. Service Worker y Manifest (NUNCA cachear como inmutable)
    @pwa_lifecycle path /sw.js /manifest.webmanifest /branding-fallback.js
    handle @pwa_lifecycle {
        header Cache-Control "no-cache, no-store, must-revalidate"
        file_server
    }

    # 3. Archivos estáticos inmutables (Vite hash, iconos, assets)
    @static_paths path /assets/* /icons/* /favicon.ico *.js *.css *.jpg *.jpeg *.png *.gif *.ico *.svg *.woff *.woff2 *.webp *.avif
    handle @static_paths {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server {
            precompressed br gzip
        }
    }

    # 4. Cualquier otro archivo estático físico existente
    @static_assets {
        file
    }
    handle @static_assets {
        file_server {
            precompressed br gzip
        }
    }

    # 5. Navegación SPA directa para el Portal Global (in.zelys.app, zelys.app, www.zelys.app)
    # Entrega instantánea en 1ms desde disco local, eliminando cualquier bucle o bloqueo de Cloudflare
    @portal host in.zelys.app zelys.app www.zelys.app
    handle @portal {
        try_files {path} /index.html
        file_server {
            precompressed br gzip
        }
    }

    # 6. Navegación SPA para Tenants (*.zelys.app) con inyección SSR de alias y branding vía red interna
    handle {
        reverse_proxy {$BACKEND_URL:http://backend:3000} {
            header_up Host {$BACKEND_HOST:backend:3000}
            header_up X-Original-Host {host}
            header_up X-Real-IP {remote_host}

            # Salvavidas de alta disponibilidad: si el backend no responde o da error (4xx/5xx),
            # servir inmediatamente el index.html local para que la app cargue sin interrupciones
            @backend_error status 400 401 403 404 500 502 503 504
            handle_response @backend_error {
                rewrite * /index.html
                file_server {
                    precompressed br gzip
                }
            }
        }
    }

    # 7. Fallback de emergencia a nivel de servidor
    handle_errors {
        rewrite * /index.html
        file_server {
            precompressed br gzip
        }
    }

    # Cabeceras de Seguridad y CSP
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # 1. HSTS (Fuerza HTTPS por 2 años, incluyendo subdominios)
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        
        # 2. Permissions Policy (Apaga hardware del cliente innecesario)
        Permissions-Policy "microphone=(), usb=(), camera=(self), geolocation=(self), payment=(self), display-capture=(self)"
        
        # 3. Content Security Policy (Asegura tus orígenes legítimos y llamadas a tu API)
        #    - worker-src: permite el Service Worker (sw.js) y Web Workers en blob: (Cloudflare Turnstile)
        #    - font-src: Google Fonts (gstatic)
        #    - connect-src: API + CDN de R2 (*.zelys.app cubre api.zelys.app y cdn.zelys.app) + Cloudflare R2 endpoints (*.r2.cloudflarestorage.com)
        #    - frame-src: Cloudflare Turnstile challenge iframe
        Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; child-src 'self' blob: https://challenges.cloudflare.com; img-src 'self' data: blob: https://flagcdn.com https://*.zelys.app https://zelys.app https:; connect-src 'self' https://zelys.app https://*.zelys.app https://*.r2.cloudflarestorage.com https://challenges.cloudflare.com https://secure.geonames.org https://flagcdn.com http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; frame-src https://challenges.cloudflare.com; manifest-src 'self' https://zelys.app https://*.zelys.app https://api.zelys.app;"
    }
}