# ==============================================================================
# Zelys ERP Backend — Environment Template
# Copy to .env for local dev. In Coolify (Production), paste only the required
# runtime variables in Developer View (NEVER commit real secrets).
# ==============================================================================

NODE_ENV=production
TRUSTED_PROXY_HEADERS=true

# PostgreSQL (dbZelys = app principal, dbReferences = SRI/Geonames/Taxonomy)
DATABASE_URL=postgres://postgres:CHANGE_ME@HOST:5432/dbZelys
REF_DATABASE_URL=postgres://postgres:CHANGE_ME@HOST:5432/dbReferences
# Required in Coolify internal Docker network without TLS:
DATABASE_SSL_MODE=disable

# Dragonfly / Redis
REDIS_URL=redis://:CHANGE_ME@HOST:6379/0

# Public & Internal URLs
FRONTEND_URL=https://in.zelys.app
FRONTEND_INTERNAL_URL=http://zelys-frontend:80
BETTER_AUTH_URL=https://api.zelys.app
BETTER_AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# Cloudflare R2 (Public & Private buckets)
R2_ENDPOINT_PUBLIC=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID_PUBLIC=CHANGE_ME
R2_SECRET_ACCESS_KEY_PUBLIC=CHANGE_ME
R2_ENDPOINT_PRIVATE=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID_PRIVATE=CHANGE_ME
R2_SECRET_ACCESS_KEY_PRIVATE=CHANGE_ME

# Email (Resend)
RESEND_API_KEY=re_CHANGE_ME
RESEND_WEBHOOK_SECRET=whsec_CHANGE_ME

# Optional OAuth & References
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEONAMES_USERNAME=
# Microsoft OAuth (only set in prod if MICROSOFT_TENANT_ID is an explicit Azure Tenant GUID, never 'common')
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
