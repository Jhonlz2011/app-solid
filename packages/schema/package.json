{
    "name": "@app/schema",
    "version": "1.0.0",
    "type": "module",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./errors": "./src/errors.ts",
        "./tables": "./src/tables/index.ts",
        "./utils": "./src/utils/index.ts",
        "./utils/*": "./src/utils/*.ts",
        "./backend": "./src/backend/index.ts",
        "./backend/*": "./src/backend/*.ts",
        "./dto": "./src/dto/index.ts",
        "./dto/*": "./src/dto/*.ts",
        "./frontend": "./src/frontend.ts",
        "./enums": "./src/enums.ts",
        "./realtime-events": "./src/realtime-events.ts",
        "./sri": "./src/tables/sri.ts",
        "./localidades": "./src/tables/localidades.ts"
    },
    "typesVersions": {
        "*": {
            "errors": [
                "./src/errors.ts"
            ],
            "tables": [
                "./src/tables/index.ts"
            ],
            "utils": [
                "./src/utils/index.ts"
            ],
            "utils/*": [
                "./src/utils/*.ts"
            ],
            "frontend": [
                "./src/frontend/d.ts"
            ],
            "backend": [
                "./src/backend/index.ts"
            ],
            "backend/*": [
                "./src/backend/*.ts"
            ],
            "dto": [
                "./src/dto/index.ts"
            ],
            "dto/*": [
                "./src/dto/*.ts"
            ],
            "enums": [
                "./src/enums.ts"
            ],
            "realtime-events": [
                "./src/realtime-events.ts"
            ],
            "sri": [
                "./src/tables/sri.ts"
            ],
            "localidades": [
                "./src/tables/localidades.ts"
            ]
        }
    },
    "dependencies": {
        "drizzle-orm": "^0.44.7",
        "drizzle-typebox": "^0.3.3",
        "postgres": "^3.4.7",
        "uuid": "^13.0.0",
        "valibot": "^1.2.0"
    },
    "peerDependencies": {
        "@sinclair/typebox": "^0.34.48"
    },
    "devDependencies": {
        "@types/uuid": "^11.0.0",
        "drizzle-valibot": "^0.4.2",
        "typescript": "^5.7.2"
    }
