# ==============================================================================
# Zelys ERP Frontend — Environment Template
# ==============================================================================
# 1) LOCAL DEVELOPMENT (Vite dev server)
VITE_API_URL=http://localhost:3000
VITE_SSE_URL=http://localhost:3000/api/sse
VITE_TURNSTILE_SITE_KEY=CHANGE_ME

# 2) PRODUCTION RUNTIME (Coolify Caddy container ONLY — do NOT set VITE_* here;
#    VITE_TURNSTILE_SITE_KEY is injected at build-time via GitHub Actions vars)
# BACKEND_URL=http://zelys-backend:3000
# BACKEND_HOST=zelys-backend:3000
