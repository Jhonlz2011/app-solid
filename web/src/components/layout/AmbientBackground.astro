---
/**
 * AmbientBackground.astro
 * Motor de Fondo Ambiental Aurora FX de Alto Rendimiento (HTML5 Canvas 2D + Fallback CSS)
 * 5 Capas: Gradientes Atmosféricos Duales, Matriz de Puntos 40px, Orbes Volumétricos, Estrellas y Luz Reactiva.
 * Optimizado para 60 FPS, pausa en segundo plano, soporte Light/Dark y Reduced Motion.
 */
---

<div class="ambient-background-root fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
  <!-- Fallback CSS Puro (visible si JS no estuviera disponible o mientras carga) -->
  <div class="ambient-css-fallback absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-slate-50 via-blue-50/80 to-indigo-100/50 dark:from-[#020617] dark:via-[#0a0e1a] dark:to-[#0f172a] transition-colors duration-500"></div>
    <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-blue-100/30 to-cyan-100/20 dark:via-blue-950/20 dark:to-cyan-950/10"></div>
    <div class="absolute inset-0 opacity-20 dark:opacity-30 bg-dot-matrix"></div>
  </div>

  <!-- Canvas Interactivo Acelerado por GPU -->
  <canvas id="ambient-canvas" class="w-full h-full block opacity-0 transition-opacity duration-700"></canvas>
</div>

<style>
  .bg-dot-matrix {
    background-image: radial-gradient(circle at center, rgba(59, 130, 246, 0.25) 1.2px, transparent 1.2px);
    background-size: 40px 40px;
  }
  :global(.dark) .bg-dot-matrix {
    background-image: radial-gradient(circle at center, rgba(59, 130, 246, 0.3) 1.2px, transparent 1.2px);
  }
</style>

<script>
  function initAmbientCanvas() {
    const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    // Estado del motor
    let isDark = document.documentElement.classList.contains('dark');
    let prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let isTabVisible = !document.hidden;
    let animationFrameId: number | null = null;
    let time = 0;
    let width = 0;
    let height = 0;
    let dpr = 1;

    const mouse = {
      x: window.innerWidth / 2,
      y: window.innerHeight / 2,
      targetX: window.innerWidth / 2,
      targetY: window.innerHeight / 2,
      active: false
    };

    // Definición de Orbes de Luz (Aurora Blobs) acordes a la identidad Zelys
    const orbs = [
      {
        relX: 0.15, relY: 0.25, radius: 300,
        lightColor: { r: 0, g: 192, b: 232, alpha: 0.16 }, // Cyan Zelys
        darkColor:  { r: 0, g: 192, b: 232, alpha: 0.26 },
        vx: 0.08, vy: 0.05, phase: 0
      },
      {
        relX: 0.85, relY: 0.58, radius: 260,
        lightColor: { r: 30, g: 114, b: 212, alpha: 0.14 }, // Azul profundo
        darkColor:  { r: 30, g: 114, b: 212, alpha: 0.22 },
        vx: -0.06, vy: -0.07, phase: Math.PI / 2
      },
      {
        relX: 0.72, relY: 0.18, radius: 170,
        lightColor: { r: 0, g: 232, b: 204, alpha: 0.12 }, // Mint
        darkColor:  { r: 0, g: 232, b: 204, alpha: 0.18 },
        vx: 0.05, vy: -0.04, phase: Math.PI
      },
      {
        relX: 0.42, relY: 0.88, radius: 320,
        lightColor: { r: 26, g: 56, b: 112, alpha: 0.10 }, // Navy
        darkColor:  { r: 0, g: 192, b: 232, alpha: 0.15 },
        vx: -0.04, vy: 0.05, phase: Math.PI * 1.5
      }
    ];

    // Definición de estrellas titilantes
    interface Star {
      x: number;
      y: number;
      radius: number;
      phase: number;
      speed: number;
      colorType: 'cyan' | 'blue';
    }

    const starCount = 26;
    const stars: Star[] = [];
    for (let i = 0; i < starCount; i++) {
      stars.push({
        x: Math.random(),
        y: Math.random(),
        radius: Math.random() * 1.4 + 0.8,
        phase: Math.random() * Math.PI * 2,
        speed: 0.02 + Math.random() * 0.03,
        colorType: Math.random() > 0.4 ? 'cyan' : 'blue'
      });
    }

    // Redimensionado con DPR limitado a 2 para evitar saturación de VRAM
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas!.width = Math.floor(width * dpr);
      canvas!.height = Math.floor(height * dpr);
      ctx!.setTransform(1, 0, 0, 1, 0, 0);
      ctx!.scale(dpr, dpr);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    // Eventos del mouse / touch con lerp suave
    window.addEventListener('mousemove', (e) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
      mouse.active = true;
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        mouse.targetX = e.touches[0].clientX;
        mouse.targetY = e.touches[0].clientY;
        mouse.active = true;
      }
    }, { passive: true });

    // Observar cambio de tema (Light / Dark)
    const themeObserver = new MutationObserver(() => {
      isDark = document.documentElement.classList.contains('dark');
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    window.addEventListener('themechange', () => {
      isDark = document.documentElement.classList.contains('dark');
    });

    // Pausar render si la pestaña está en segundo plano (ahorro de batería)
    document.addEventListener('visibilitychange', () => {
      isTabVisible = !document.hidden;
      if (isTabVisible && !animationFrameId) {
        lastFrameTime = performance.now();
        loop(lastFrameTime);
      }
    });

    // Detección de reduced motion
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    motionQuery.addEventListener('change', (e) => {
      prefersReducedMotion = e.matches;
    });

    // Bucle de renderizado a 60 FPS
    let lastFrameTime = performance.now();

    function render(deltaRatio: number) {
      if (!ctx || width === 0 || height === 0) return;

      // Suavizado del puntero con interpolación
      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      if (!prefersReducedMotion) {
        time += 0.012 * deltaRatio;
      }

      ctx.clearRect(0, 0, width, height);

      // ==========================================
      // CAPA 1 & 2: Gradientes Atmosféricos Base
      // ==========================================
      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
      if (isDark) {
        bgGrad.addColorStop(0, '#020617');    // slate-950
        bgGrad.addColorStop(0.5, '#070c18');  // atmósfera noche
        bgGrad.addColorStop(1, '#0b1324');    // slate-900
      } else {
        bgGrad.addColorStop(0, '#f8fafc');    // slate-50
        bgGrad.addColorStop(0.5, '#f0f7ff');  // blue-50
        bgGrad.addColorStop(1, '#e0e7ff');    // indigo-100
      }
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // Gradiente diagonal secundario
      const diagGrad = ctx.createLinearGradient(0, height, width, 0);
      if (isDark) {
        diagGrad.addColorStop(0, 'rgba(0,0,0,0)');
        diagGrad.addColorStop(0.6, 'rgba(0, 192, 232, 0.07)'); // Cyan Zelys
        diagGrad.addColorStop(1, 'rgba(30, 114, 212, 0.05)');  // Azul Zelys
      } else {
        diagGrad.addColorStop(0, 'rgba(255,255,255,0)');
        diagGrad.addColorStop(0.6, 'rgba(219, 234, 254, 0.22)');
        diagGrad.addColorStop(1, 'rgba(207, 250, 254, 0.18)');
      }
      ctx.fillStyle = diagGrad;
      ctx.fillRect(0, 0, width, height);

      // ==========================================
      // CAPA 3: Matriz de Puntos (Dot Matrix 40px)
      // ==========================================
      const gridSize = 40;
      const gridOpacity = isDark ? 0.25 : 0.20;
      ctx.fillStyle = isDark
        ? `rgba(0, 192, 232, ${gridOpacity})`
        : `rgba(30, 114, 212, ${gridOpacity})`;

      for (let x = 0; x < width; x += gridSize) {
        for (let y = 0; y < height; y += gridSize) {
          ctx.beginPath();
          ctx.arc(x, y, 1, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // ==========================================
      // CAPA 4: Orbes Volumétricos de Aurora (Blobs)
      // ==========================================
      orbs.forEach((orb, i) => {
        const motionFactor = prefersReducedMotion ? 0 : 1;
        const posX = (orb.relX * width) + Math.sin(time + orb.phase) * (35 * motionFactor);
        const posY = (orb.relY * height) + Math.cos(time * 0.8 + orb.phase) * (30 * motionFactor);

        // Paralaje sutil con el cursor
        const parallaxX = (mouse.x - width / 2) * (0.015 * (i + 1));
        const parallaxY = (mouse.y - height / 2) * (0.015 * (i + 1));

        const currentX = posX + parallaxX;
        const currentY = posY + parallaxY;
        const currentRadius = orb.radius + (Math.sin(time * 0.5 + orb.phase) * 15 * motionFactor);

        const color = isDark ? orb.darkColor : orb.lightColor;

        const orbGrad = ctx.createRadialGradient(
          currentX, currentY, 0,
          currentX, currentY, Math.max(10, currentRadius)
        );

        orbGrad.addColorStop(0, `rgba(${color.r}, ${color.g}, ${color.b}, ${color.alpha})`);
        orbGrad.addColorStop(0.45, `rgba(${color.r}, ${color.g}, ${color.b}, ${color.alpha * 0.35})`);
        orbGrad.addColorStop(1, `rgba(${color.r}, ${color.g}, ${color.b}, 0)`);

        ctx.fillStyle = orbGrad;
        ctx.beginPath();
        ctx.arc(currentX, currentY, Math.max(10, currentRadius), 0, Math.PI * 2);
        ctx.fill();
      });

      // Luz suave de cursor
      if (mouse.active) {
        const mouseGlowRadius = 240;
        const mouseGrad = ctx.createRadialGradient(
          mouse.x, mouse.y, 0,
          mouse.x, mouse.y, mouseGlowRadius
        );
        if (isDark) {
          mouseGrad.addColorStop(0, 'rgba(0, 192, 232, 0.12)');
          mouseGrad.addColorStop(0.5, 'rgba(30, 114, 212, 0.04)');
          mouseGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        } else {
          mouseGrad.addColorStop(0, 'rgba(0, 192, 232, 0.10)');
          mouseGrad.addColorStop(0.5, 'rgba(30, 114, 212, 0.03)');
          mouseGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
        }
        ctx.fillStyle = mouseGrad;
        ctx.beginPath();
        ctx.arc(mouse.x, mouse.y, mouseGlowRadius, 0, Math.PI * 2);
        ctx.fill();
      }

      // ==========================================
      // CAPA 5: Estrellas Titilantes (Twinkling Stardust)
      // ==========================================
      stars.forEach(star => {
        if (!prefersReducedMotion) {
          star.phase += star.speed * deltaRatio;
        }
        const pulse = (Math.sin(star.phase) + 1) / 2;
        const alpha = 0.2 + pulse * 0.7;

        const sx = star.x * width;
        const sy = star.y * height;

        let r = 0, g = 192, b = 232;
        if (isDark) {
          if (star.colorType === 'cyan') { r = 0; g = 232; b = 204; } // mint
          else { r = 0; g = 192; b = 232; } // cyan
        } else {
          if (star.colorType === 'cyan') { r = 0; g = 160; b = 210; }
          else { r = 30; g = 114; b = 212; }
        }

        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
        ctx.beginPath();
        ctx.arc(sx, sy, star.radius * (0.8 + pulse * 0.4), 0, Math.PI * 2);
        ctx.fill();

        // Halo suave en picos de brillo
        if (pulse > 0.8) {
          ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${(pulse - 0.8) * 0.35})`;
          ctx.beginPath();
          ctx.arc(sx, sy, star.radius * 3.5, 0, Math.PI * 2);
          ctx.fill();
        }
      });
    }

    function loop(now: number) {
      if (!isTabVisible) {
        animationFrameId = null;
        return;
      }

      const elapsed = now - lastFrameTime;
      lastFrameTime = now;
      const deltaRatio = Math.min(Math.max(elapsed / 16.666, 0.5), 3.0);

      render(deltaRatio);
      animationFrameId = requestAnimationFrame(loop);
    }

    // Revelar canvas suavemente
    canvas.classList.remove('opacity-0');
    lastFrameTime = performance.now();
    animationFrameId = requestAnimationFrame(loop);
  }

  // Inicializar tras DOM
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAmbientCanvas);
  } else {
    initAmbientCanvas();
  }
</script>
